<!-- indexer::stop -->
<div id="{{ id }}" class="hofff-rate-it {{ (class ~ ' ' ~ rateit_class|default(''))|trim }} block" itemtype="http://schema.org/CreativeWork" itemscope{{ cssID|default|raw }}>
    <meta itemprop="name" content="{{ itemreviewed|raw }}">
    {% if showBefore %}
        <div class="hofff-rate-it-message">{{ description|raw }}</div>
    {% endif %}
    <div class="hofff-rate-it-widget hofff-rate-it-disabled{% if votes == 0 %} hofff-rate-it-unrated{% endif %}"
         data-rating="{{ actRating }}"
         data-max="{{ maxRating }}"
         data-enabled="{{ enabled ? 'true' : 'false' }}"
         data-id="{{ ratingId }}"
         data-type="{{ ratingType }}"
    >
        <i class="hofff-rate-it-icon-rated fas fa-star"></i>
        <i class="hofff-rate-it-icon-unrated far fa-star"></i>
        <i class="hofff-rate-it-icon-half fas fa-star-half-alt"></i>
    </div>
    {% if showAfter %}
        <div class="hofff-rate-it-message">{{ description|raw }}</div>
    {% endif %}
    <span class="rating-microdata" itemtype="http://schema.org/AggregateRating" itemscope itemprop="aggregateRating">
        <meta itemprop="ratingValue" content="{{ actRating }}">
        <meta itemprop="worstRating" content="0">
        <meta itemprop="bestRating" content="{{ maxRating }}">
        <meta itemprop="ratingCount" content="{{ votes }}">
        {% if url|default %}
        <span itemprop="itemReviewed" itemtype="https://schema.org/CreativeWork" itemscope>
            <meta itemprop="name" content="{{ itemreviewed|raw }}"/>
        </span>
        {% endif %}
    </span>
</div>
<!-- indexer::continue -->
