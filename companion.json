{
  "receipts": ["projects/contao-bundle/common"],
  "config": {
    "phpConstraint": "^8.3"
  },
  "tools": {
    "composer": {
      "namespace": "Hofff\\Contao\\RateIt",
      "constraints": {
        "#^contao/.+-bundle$#": "^5.3",
        "#^symfony/(?!polyfill-)[a-z0-9\\-]+(?<!-contracts)$#": "^6.4 || ^7.0",
        "#^symfony/.*-contracts$#": "^3.0",
        "#^psr/log$#": "^1.0 || ^2.0 || ^3.0"
      }
    },
    "psalm": {
      "configuration": {
        "errorLevel": "8"
      }
    },
    "phpcq": {
      "plugins": {
        "phpunit": false,
        "rector": false
      },
      "presets": {
        "composer-require-checker": {
          "tasks": {
            "composer-require-checker": {
              "config": {
                "config_file": ".composer-require-checker.json"
              }
            }
          }
        },
        "phpcpd": {
          "tasks": {
            "phpcpd": {
              "config": {
                "exclude": ["src/Rating/RatingService.php", "src/Frontend/RateItFrontend.php"]
              }
            }
          }
        }
      }
    }
  }
}
