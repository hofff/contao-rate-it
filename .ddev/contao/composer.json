{
  "name": "contao/managed-edition",
  "description": "Contao Managed Edition",
  "license": "LGPL-3.0-or-later",
  "type": "project",
  "require": {
    "contao/calendar-bundle": "^6.0",
    "contao/comments-bundle": "^6.0",
    "contao/conflicts": "@dev",
    "contao/faq-bundle": "^6.0",
    "contao/listing-bundle": "^6.0",
    "contao/manager-bundle": "6.*",
    "contao/news-bundle": "^6.0",
    "contao/newsletter-bundle": "^6.0",
    "hofff/contao-rate-it": "@dev",
    "fortawesome/font-awesome": "^7.3"
  },
  "require-dev": {
    "netzmacht/contao-ai-bridge": "@dev"
  },
  "conflict": {
    "contao-components/installer": "<1.3"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "contao-community-alliance/composer-plugin": true,
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "php-http/discovery": false
    }
  },
  "extra": {
    "contao-component-dir": "assets"
  },
  "scripts": {
    "post-install-cmd": [
      "@php vendor/bin/contao-setup"
    ],
    "post-update-cmd": [
      "@php vendor/bin/contao-setup"
    ]
  },
  "repositories": {
    "local": {
      "type": "path",
      "url": "../.."
    },
    "contao-ai-bridge": {
      "type": "composer",
      "url": "https://packages.netzmacht.de/r/"
    }
  }
}
